{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/sentinel",
      "destination": "/sentinel.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
